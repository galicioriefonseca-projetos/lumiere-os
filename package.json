{
  "name": "lumiere-os",
  "private": true,
  "version": "1.6.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "node copy-assets.js && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run firestore.rules.test.ts\"",
    "test:webhook": "vitest run tests/webhook/webhook-security.test.ts",
    "test:billing": "vitest run tests/billing/billing-security.test.ts",
    "test": "npm run test:webhook && npm run test:billing",
    "test:security": "npm run test:webhook && npm run test:billing",
    "check:release": "node scripts/verify-release.mjs",
    "verify": "npm run lint && npm run test:security && npm run build && npm run check:release"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "motion-utils": "^12.39.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.76.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "serverless-http": "^4.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.27",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  },
  "description": "Plataforma SaaS de gestão para salões, clínicas de estética e negócios de beleza.",
  "overrides": {
    "firebase-admin": {
      "jwks-rsa": "^3.2.2"
    },
    "jwks-rsa": "^3.2.2"
  }
}
