rules_version = '2';
service cloud.firestore {
  match /databases/{database}/3documents {
    
    // Safety Net - Allow Platform Admin globally, deny others by default
    match /{document=**} {
      allow read, write: if isPlatformAdmin();
    }

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userEmail() {
      return 'email' in request.auth.token ? request.auth.token.email : '';
    }

    // Helper for role field
    function userRole() {
      return exists(userDoc()) && 'role' in get(userDoc()).data ? get(userDoc()).data.role : 'none';
    }

    // Helper for salonId field
    function userSalonId() {
      return exists(userDoc()) && 'salonId' in get(userDoc()).data ? get(userDoc()).data.salonId : 'none';
    }

    // Super Admin global role helper
    function isPlatformAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == "platform_admin") ||
        ('platform_admin' in request.auth.token && request.auth.token.platform_admin == true) ||
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)) ||
        (exists(userDoc()) && 'role' in get(userDoc()).data && get(userDoc()).data.role == "platform_admin")
      );
    }

    function isOwnerOfUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Specific salon level checks
    function isSalonOwner(salonId) {
      return isSignedIn() && exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 'role' in get(userDoc()).data && (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin");
    }

    function isSalonManager(salonId) {
      return isSignedIn() && exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 'role' in get(userDoc()).data && get(userDoc()).data.role == "manager";
    }

    function isSalonReceptionist(salonId) {
      return isSignedIn() && exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 'role' in get(userDoc()).data && get(userDoc()).data.role == "receptionist";
    }

    // Helper for managers, receptionists, etc.
    function isSalonAttendant(salonId) {
      return isSignedIn() && exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 'role' in get(userDoc()).data && get(userDoc()).data.role == "attendant";
    }

    function isSalonProfessional(salonId) {
      return isSignedIn() && exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 'role' in get(userDoc()).data && get(userDoc()).data.role == "professional";
    }

    function isSalonMember(salonId) {
      return isSignedIn() && (
        isPlatformAdmin() ||
        canUseTutorialDemo(salonId) ||
        (exists(userDoc()) && 'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId) ||
        exists(/databases/$(database)/documents/salons/$(salonId)/professionals/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/salons/$(salonId)) && 'ownerId' in get(/databases/$(database)/documents/salons/$(salonId)).data && get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid)
      );
    }

    // --- Demo/Tutorial User Helpers ---
    function isTutorialDemoSalon(salonId) {
      return salonId == "tutorial_lumiere_studio";
    }

    function isTutorialDemoUser() {
      return isSignedIn() && 'is_demo' in request.auth.token && request.auth.token.is_demo == true;
    }

    function canUseTutorialDemo(salonId) {
      return isTutorialDemoUser() && isTutorialDemoSalon(salonId);
    }

    // Permission gates
    function canManageSalon(salonId) {
      return isSignedIn() && (
        isPlatformAdmin() || canUseTutorialDemo(salonId) || (
          exists(/databases/$(database)/documents/salons/$(salonId)) && 
          'ownerId' in get(/databases/$(database)/documents/salons/$(salonId)).data && 
          get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid
        ) || (
          exists(userDoc()) && 
          'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
          'role' in get(userDoc()).data && 
          (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin" || get(userDoc()).data.role == "manager")
        )
      );
    }

    function canOperateFrontDesk(salonId) {
      return isPlatformAdmin() || canUseTutorialDemo(salonId) || (
        exists(userDoc()) && 
        'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
        'role' in get(userDoc()).data && 
        (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin" || get(userDoc()).data.role == "manager" || get(userDoc()).data.role == "receptionist" || get(userDoc()).data.role == "attendant")
      );
    }

    function canModifyCrmStage(salonId) {
      return isPlatformAdmin() || canUseTutorialDemo(salonId) || (
        exists(userDoc()) && 
        'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
        'role' in get(userDoc()).data && 
        (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin" || get(userDoc()).data.role == "manager" || get(userDoc()).data.role == "receptionist")
      );
    }

    // --- End Permission gates ---
    function canEvaluateTeam(salonId) {
      return isPlatformAdmin() || canUseTutorialDemo(salonId) || (
        exists(userDoc()) && 
        'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
        'role' in get(userDoc()).data && 
        (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin" || get(userDoc()).data.role == "manager")
      );
    }

    function canRecordEvaluation(salonId) {
      return isPlatformAdmin() || canUseTutorialDemo(salonId) || (
        exists(userDoc()) && 
        'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
        'role' in get(userDoc()).data && 
        (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin" || get(userDoc()).data.role == "manager" || get(userDoc()).data.role == "receptionist" || get(userDoc()).data.role == "attendant")
      );
    }

    function canManageBilling(salonId) {
      return isSignedIn() && (
        isPlatformAdmin() ||
        canUseTutorialDemo(salonId) ||
        (
          exists(userDoc()) && 
          'salonId' in get(userDoc()).data && get(userDoc()).data.salonId == salonId && 
          'role' in get(userDoc()).data && 
          (get(userDoc()).data.role == "owner" || get(userDoc()).data.role == "admin")
        ) ||
        (
          exists(/databases/$(database)/documents/salons/$(salonId)) && (
            ('ownerId' in get(/databases/$(database)/documents/salons/$(salonId)).data && get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid)
          )
        )
      );
    }

    // --- Collection Rules ---

    // platformAdmins collection
    match /platformAdmins/{userId} {
      allow read: if isOwnerOfUser(userId) || isPlatformAdmin();
    }

    // Users collection
    // Plans (Public read)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /users/{userId} {
      allow get: if isOwnerOfUser(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        resource.data.salonId == userSalonId()
      );
      
      allow create: if isPlatformAdmin() || (
        isOwnerOfUser(userId) &&
        request.resource.data.keys().hasOnly(['id', 'email', 'fullName', 'name', 'phone', 'createdAt', 'updatedAt', 'role', 'salonId', 'avatarUrl', 'onboardingStatus']) &&
        request.resource.data.role == "pending" &&
        request.resource.data.email == userEmail() &&
        (!('salonId' in request.resource.data) || request.resource.data.salonId == null || request.resource.data.salonId == "")
      );
      
      allow update: if isPlatformAdmin() || (
        isOwnerOfUser(userId) && 
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'salonId', 'permissions', 'privileges', 'platform_admin', 'admin']) ||
          (
            isTutorialDemoUser() && 
            request.resource.data.salonId == "tutorial_lumiere_studio" && 
            (request.resource.data.role == "owner" || request.resource.data.role == "manager")
          )
        )
      );
    }
    
    // Salons collection
    match /salons/{salonId} {
      allow create: if isPlatformAdmin();
      
      // Leitura pública removida
      
      // Access only for platform admin or salon members/owners, plus allow for tutorial demo user
      allow get: if isPlatformAdmin() || (
        isSignedIn() && (
          resource.data.ownerId == request.auth.uid || 
          (exists(userDoc()) && userSalonId() == salonId) ||
          canUseTutorialDemo(salonId)
        )
      );
      
      // Only platformAdmins can list all salons, but allow demo list for the authorized demo user, or owners to query their own salons
      allow list: if isPlatformAdmin() || (
        isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          (isTutorialDemoUser() && isTutorialDemoSalon(resource.id))
        )
      );
      
      // Updates allowed for platform_admin, owners, or managers, shielding sensitive pricing/billing/config fields
      allow update: if isPlatformAdmin() || (
        isSignedIn() && 
        (
          resource.data.ownerId == request.auth.uid || 
          (exists(userDoc()) && userSalonId() == salonId && (userRole() == "owner" || userRole() == "manager" || userRole() == "admin")) ||
          canUseTutorialDemo(salonId)
        ) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'subscriptionStatus', 'activationStatus', 'paymentStatus', 'isActive', 'billingProvider', 'billingMode', 'professionalLimit', 'professionalsLimit', 'maxProfessionals', 'founderAuthorized', 'isFounderAuthorized', 'isFounder', 'caktoSubscriptionId', 'caktoOrderId', 'caktoCustomerId', 'caktoOfferId', 'caktoCheckoutUrl', 'caktoCheckoutEmail', 'nextBillingDate', 'currentPeriodStart', 'currentPeriodEnd', 'lastPaymentAt', 'lastPaymentAmount', 'billingSyncRequired', 'billingSyncReason', 'pendingPlan', 'pendingOfferId', 'pendingCheckoutUrl', 'pendingCheckoutEmail', 'pendingRequestedAt', 'pendingCheckoutPurpose', 'pendingBillingActivation', 'pendingPlanChange', 'ownerId', 'ownerEmail', 'deletedAt'
        ])
      );
                     
      allow delete: if isPlatformAdmin();
    }

    // Bug Reports
    match /bugReports/{bugReportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isPlatformAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Invites collection (Hardened)
    match /invites/{inviteId} {
      allow create: if isPlatformAdmin() || (
        isSignedIn() &&
        exists(userDoc()) &&
        request.resource.data.keys().hasOnly([
          'id', 'salonId', 'salonName', 'invitedByUserId', 'invitedByName', 'invitedByEmail',
          'inviteType', 'role', 'category', 'specialty', 'professionalFunction',
          'maxUses', 'usesCount', 'email', 'invitedName', 'invitedPhone',
          'status', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == inviteId &&
        request.resource.data.salonId == userSalonId() &&
        request.resource.data.invitedByUserId == request.auth.uid &&
        request.resource.data.invitedByEmail == userEmail() &&
        (userRole() == "owner" || userRole() == "manager" || userRole() == "admin") &&
        request.resource.data.inviteType in ["manager", "receptionist", "attendant", "professional", "function_link", "team_public_link"] &&
        request.resource.data.role in ["manager", "receptionist", "attendant", "professional"] &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.expiresAt is timestamp &&
        (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string) &&
        (!('usesCount' in request.resource.data) || request.resource.data.usesCount == 0) &&
        (!('maxUses' in request.resource.data) || (request.resource.data.maxUses is int && request.resource.data.maxUses > 0 && request.resource.data.maxUses <= 10000)) &&
        (request.resource.data.inviteType != "team_public_link" || request.resource.data.role == "professional") &&
        (request.resource.data.inviteType != "function_link" || ('maxUses' in request.resource.data && 'usesCount' in request.resource.data)) &&
        (request.resource.data.inviteType != "team_public_link" || ('maxUses' in request.resource.data && 'usesCount' in request.resource.data))
      );

      allow get: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        userSalonId() == resource.data.salonId && 
        (userRole() == "owner" || userRole() == "manager" || userRole() == "admin")
      );
      
      allow list: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        userSalonId() == resource.data.salonId && 
        (userRole() == "owner" || userRole() == "manager" || userRole() == "admin")
      );

      allow update: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        userSalonId() == resource.data.salonId && 
        (userRole() == "owner" || userRole() == "manager" || userRole() == "admin") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        resource.data.status == "pending" &&
        request.resource.data.status == "canceled" &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['salonId', 'role', 'inviteType', 'maxUses', 'createdAt', 'email'])
      );
    }

    // --- Salons Subcollections (Hardened & Granular RBAC) ---

    // Subscriptions (Mercado Pago)
    match /salons/{salonId}/subscriptions/{subscriptionId} {
      allow read: if canManageSalon(salonId);
      allow write: if isPlatformAdmin();
    }

    // Billing History
    match /salons/{salonId}/billingHistory/{historyId} {
      allow read: if canManageSalon(salonId) || canManageBilling(salonId);
      allow write: if isPlatformAdmin();
    }

    // 1. Professionals & Staff
    match /salons/{salonId}/professionals/{professionalId} {
      allow read: if isSalonMember(salonId) ;
      
      allow create: if canManageSalon(salonId) || (
        isSignedIn() && 
        professionalId == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userSalonId() == salonId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.professionalId == request.auth.uid &&
        request.resource.data.role == userRole() &&
        request.resource.data.isActive == true &&
        request.resource.data.status == "active"
      );
      
      allow update: if canManageSalon(salonId) || (
        isSignedIn() && 
        professionalId == request.auth.uid &&
        userSalonId() == salonId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'salonId', 'userId', 'professionalId', 'isActive', 'status', 'joinedByInvite', 'inviteId', 'inviteType', 'createdAt', 'commissionRate'
        ])
      );
      allow delete: if canManageSalon(salonId);
    }

    // 2. Appointments & Appointments Scheduling
    match /salons/{salonId}/appointments/{appointmentId} {
      allow read: if isSalonMember(salonId) ;
      allow create, update, delete: if canOperateFrontDesk(salonId);
      
      allow create: if
        false;
    }

    // 3. Checklist Configurations (Templates)
    match /salons/{salonId}/checklists/{checklistId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && exists(userDoc()) && userSalonId() == salonId);
      allow write: if canManageSalon(salonId);
    }

    // 4. Checklist Daily Runs (Avaliações Operacionais)
    match /salons/{salonId}/checklistRuns/{runId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && exists(userDoc()) && userSalonId() == salonId);
      allow create, update: if canRecordEvaluation(salonId);
      allow delete: if false;
    }

    // 5. Monthly Goals
    match /salons/{salonId}/goals/{goalId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && exists(userDoc()) && userSalonId() == salonId);
      allow write: if canManageSalon(salonId);
    }

    // 6. Professional-assigned Goals
    match /salons/{salonId}/professionalGoals/{goalId} {
      allow read: if canManageSalon(salonId) || (
        isSalonProfessional(salonId) && resource.data.professionalId == request.auth.uid
      );
      allow create, update, delete: if canManageSalon(salonId);
    }

    // 7. Clients
    match /salons/{salonId}/clients/{clientId} {
      allow get: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
      allow list: if canOperateFrontDesk(salonId);
      allow create: if canOperateFrontDesk(salonId);
      allow update: if canOperateFrontDesk(salonId) && (
        request.resource.data.crmStage == resource.data.crmStage || 
        canModifyCrmStage(salonId)
      );
      allow delete: if false;

      // History logs subcollection
      match /history/{historyId} {
        allow get, list: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
        allow create, update: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
        allow delete: if false;
      }
    }

    // 8. Services Catalogue
    match /salons/{salonId}/services/{serviceId} {
      allow read: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId) ;
      allow create, update, delete: if canManageSalon(salonId);
    }

    // 9. Categories
    match /salons/{salonId}/categories/{categoryId} {
      allow read: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId) ;
      allow create, update, delete: if canManageSalon(salonId);
    }

    // 10. Audit Logs (Append-Only, restricted read)
    match /salons/{salonId}/auditLogs/{logId} {
      allow read: if canManageSalon(salonId);
      allow create: if isSignedIn() && exists(userDoc()) && userSalonId() == salonId;
      allow update, delete: if false;
    }

    // 11. Financial Transactions
    match /salons/{salonId}/financialTransactions/{transactionId} {
      allow read, write: if canManageSalon(salonId);
    }

    // 12. Inventory / Stock Management
    match /salons/{salonId}/inventory/{itemId} {
      allow read: if canOperateFrontDesk(salonId);
      allow write: if canManageSalon(salonId);
    }

    // 13. Marketing Coupons
    match /salons/{salonId}/marketingCoupons/{couponId} {
      allow read: if canOperateFrontDesk(salonId);
      allow write: if canManageSalon(salonId);
    }

    // 14. Membership Plans
    match /salons/{salonId}/membershipPlans/{planId} {
      allow read: if canOperateFrontDesk(salonId);
      allow write: if canManageSalon(salonId);
    }

    // 15. Membership Subscribers
    match /salons/{salonId}/membershipSubscribers/{subId} {
      allow read: if canOperateFrontDesk(salonId);
      allow write: if canManageSalon(salonId);
    }

    // 16. Pricing Calculations
    match /salons/{salonId}/pricing_calculations/{calculationId} {
      allow read, write: if isAuthenticated() && isSalonMember(salonId);
    }

    // 17. Comandas / Active Bills
    match /salons/{salonId}/comandas/{comandaId} {
      allow read, write: if isAuthenticated() && isSalonMember(salonId);
    }

    // 18. Gamification Campaigns
    match /salons/{salonId}/gamification_campaigns/{campaignId} {
      allow read, write: if isAuthenticated() && isSalonMember(salonId);
    }

    // 20. Gamification Profiles and History
    match /salons/{salonId}/gamification/{document=**} {
      allow read, write: if isAuthenticated() && isSalonMember(salonId);
    }

    // 19. Production Error Logs
    match /salons/{salonId}/productionLogs/{logId} {
      allow create: if isAuthenticated() && isSalonMember(salonId);
      allow read, update, delete: if isPlatformAdmin();
    }

    // 22. Payments
    match /salons/{salonId}/payments/{paymentId} {
      allow read: if canManageSalon(salonId);
      allow create: if (
        isSignedIn() && 
        exists(userDoc()) && 
        userSalonId() == salonId && 
        (userRole() == "owner" || userRole() == "admin")
      ) && (
        request.resource.data.keys().hasOnly(['status', 'method', 'provider', 'salonId', 'amount', 'createdAt']) &&
        request.resource.data.status == "reported" &&
        request.resource.data.method == "pix" &&
        request.resource.data.provider == "manual_pix" &&
        request.resource.data.salonId == salonId &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.createdAt is int
      );
      allow update, delete: if isPlatformAdmin();
    }
    
    // Fallback Catch-All for any other subcollections under salons
    match /salons/{salonId}/{collectionName}/{docId} {
      allow read, write: if isPlatformAdmin();
    }

    // 21. Auth Audit Logs
    match /authAuditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
