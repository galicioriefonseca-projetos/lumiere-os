rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net - Deny Everything By Default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Helper for role field
    function userRole() {
      return get(userDoc()).data.role;
    }

    // Helper for salonId field
    function userSalonId() {
      return get(userDoc()).data.salonId;
    }

    // Super Admin global role helper
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function isOwnerOfUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Specific salon level checks
    function isSalonOwner(salonId) {
      return isSignedIn() && exists(userDoc()) && userSalonId() == salonId && (userRole() == "owner" || userRole() == "admin");
    }

    function isSalonManager(salonId) {
      return isSignedIn() && exists(userDoc()) && userSalonId() == salonId && userRole() == "manager";
    }

    function isSalonReceptionist(salonId) {
      return isSignedIn() && exists(userDoc()) && userSalonId() == salonId && userRole() == "receptionist";
    }

    function isSalonAttendant(salonId) {
      return isSignedIn() && exists(userDoc()) && userSalonId() == salonId && userRole() == "attendant";
    }

    function isSalonProfessional(salonId) {
      return isSignedIn() && exists(userDoc()) && userSalonId() == salonId && userRole() == "professional";
    }

    // Permission gates
    function canManageSalon(salonId) {
      return isPlatformAdmin() || isSalonOwner(salonId) || isSalonManager(salonId) || request.auth.token.email == "leandropfonseca20@gmail.com";
    }

    function canOperateFrontDesk(salonId) {
      return isPlatformAdmin() || isSalonOwner(salonId) || isSalonManager(salonId) || isSalonReceptionist(salonId) || isSalonAttendant(salonId) || request.auth.token.email == "leandropfonseca20@gmail.com";
    }

    function canEvaluateTeam(salonId) {
      return isPlatformAdmin() || isSalonOwner(salonId) || isSalonManager(salonId) || request.auth.token.email == "leandropfonseca20@gmail.com";
    }

    // --- Collection Rules ---

    // platformAdmins collection
    match /platformAdmins/{userId} {
      allow read: if isOwnerOfUser(userId) || isPlatformAdmin();
    }

    // Users collection
    match /users/{userId} {
      // User can read their own profile, or platform admins can read any
      allow get: if isOwnerOfUser(userId) || isPlatformAdmin();
      
      // Members of the same salon can read salon professionals / members lists
      allow list: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        resource.data.salonId == userSalonId()
      );
      
      // Client creation check
      allow create: if isOwnerOfUser(userId) && (
        request.resource.data.role != 'platform_admin' ||
        exists(/databases/$(database)/documents/platformAdmins/$(userId))
      );
      
      // Client updates protect role-escalation and salon spoofing
      allow update: if isPlatformAdmin() || (
        isOwnerOfUser(userId) && 
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'salonId']) ||
          request.auth.token.email == "leandropfonseca20@gmail.com"
        )
      );
    }

    // Salons collection
    match /salons/{salonId} {
      // Creator must assign themselves as the owner or be superadmin
      allow create: if (isSignedIn() && request.resource.data.ownerId == request.auth.uid) || isPlatformAdmin();
      
      // Access only for platform admin or salon members/owners, plus allow for demo salons or demo user
      allow get: if isPlatformAdmin() || (
        isSignedIn() && (
          resource.data.ownerId == request.auth.uid || 
          (exists(userDoc()) && userSalonId() == salonId) ||
          resource.data.isDemo == true ||
          request.auth.token.email == "leandropfonseca20@gmail.com"
        )
      );
      
      // Only platformAdmins can list all salons, but allow demo list
      allow list: if isPlatformAdmin() || (
        isSignedIn() && (
          resource.data.isDemo == true ||
          request.auth.token.email == "leandropfonseca20@gmail.com"
        )
      );
      
      // Updates allowed for platform_admin or owners, shielding sensitive pricing/billing fields
      allow update: if isPlatformAdmin() || (
        isSignedIn() && 
        (
          resource.data.ownerId == request.auth.uid || 
          (exists(userDoc()) && userSalonId() == salonId && userRole() == "owner") ||
          resource.data.isDemo == true ||
          request.auth.token.email == "leandropfonseca20@gmail.com"
        ) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'plan', 'subscriptionStatus', 'activationStatus', 'isActive', 'professionalsLimit', 'deletedAt'
        ])
      );
                     
      allow delete: if isPlatformAdmin();
    }

    // Bug Reports
    match /bugReports/{bugReportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if isPlatformAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Invites collection (Hardened)
    match /invites/{inviteId} {
      // Get is public only for pending invites (not expired check on front-end)
      allow get: if isPlatformAdmin() || (
        resource.data.status == "pending"
      );
      
      // Only platform admin and salon managers/owners can list invitations
      allow list: if isPlatformAdmin() || (
        isSignedIn() && 
        exists(userDoc()) && 
        userSalonId() == resource.data.salonId && 
        (userRole() == "owner" || userRole() == "manager" || userRole() == "admin")
      );
      
      // Managers, owners, or admins can create invites
      allow create: if isSignedIn() && (
        isPlatformAdmin() || (
          exists(userDoc()) && 
          request.resource.data.salonId == userSalonId() && 
          (userRole() == "owner" || userRole() == "manager" || userRole() == "admin") && 
          (request.resource.data.role == "manager" || request.resource.data.role == "receptionist" || request.resource.data.role == "attendant" || request.resource.data.role == "professional")
        )
      );
      
      // Accept invite or manage cancellations (Hardened)
      allow update: if isPlatformAdmin() || (
        isSignedIn() && (
          // Cancellation by salon owner/manager (only pending -> canceled, no field mutations)
          (
            exists(userDoc()) && 
            userSalonId() == resource.data.salonId && 
            (userRole() == "owner" || userRole() == "manager" || userRole() == "admin") &&
            resource.data.status == "pending" &&
            request.resource.data.status == "canceled" &&
            request.resource.data.salonId == resource.data.salonId && 
            request.resource.data.role == resource.data.role && 
            request.resource.data.inviteType == resource.data.inviteType && 
            request.resource.data.email == resource.data.email && 
            request.resource.data.createdAt == resource.data.createdAt
          ) ||
          // Sealed state transaction: accepting a pending invite
          (
            resource.data.status == "pending" && 
            request.resource.data.status == "accepted" && 
            request.resource.data.acceptedByUserId == request.auth.uid && 
            request.resource.data.salonId == resource.data.salonId && 
            request.resource.data.role == resource.data.role && 
            request.resource.data.inviteType == resource.data.inviteType && 
            request.resource.data.email == resource.data.email && 
            request.resource.data.createdAt == resource.data.createdAt
          ) ||
          // Sealed state transaction: accepting a pending function-based multi-use invite
          (
            resource.data.inviteType == "function_link" &&
            resource.data.status == "pending" &&
            resource.data.usesCount < resource.data.maxUses &&
            request.resource.data.salonId == resource.data.salonId && 
            request.resource.data.role == resource.data.role && 
            request.resource.data.inviteType == resource.data.inviteType && 
            request.resource.data.category == resource.data.category &&
            request.resource.data.specialty == resource.data.specialty &&
            request.resource.data.professionalFunction == resource.data.professionalFunction &&
            request.resource.data.maxUses == resource.data.maxUses &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.usesCount == resource.data.usesCount + 1 &&
            (
              (request.resource.data.usesCount < resource.data.maxUses && request.resource.data.status == "pending") ||
              (request.resource.data.usesCount == resource.data.maxUses && request.resource.data.status == "used_limit_reached")
            )
          )
        )
      );
      
      allow delete: if isPlatformAdmin();
    }

    // --- Salons Subcollections (Hardened & Granular RBAC) ---

    // 1. Professionals & Staff
    match /salons/{salonId}/professionals/{professionalId} {
      allow get: if canOperateFrontDesk(salonId) || (isSalonProfessional(salonId) && professionalId == request.auth.uid);
      allow list: if canOperateFrontDesk(salonId);
      
      allow create: if canManageSalon(salonId) || (
        isSignedIn() && 
        professionalId == request.auth.uid &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userSalonId() == salonId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.professionalId == request.auth.uid &&
        request.resource.data.role == userRole() &&
        request.resource.data.isActive == true &&
        request.resource.data.status == "active"
      );
      
      allow update, delete: if canManageSalon(salonId);
    }

    // 2. Appointments & Appointments Scheduling
    match /salons/{salonId}/appointments/{appointmentId} {
      allow read: if canOperateFrontDesk(salonId) || (
        isSalonProfessional(salonId) && resource.data.professionalId == request.auth.uid
      );
      allow create, update, delete: if canOperateFrontDesk(salonId);
    }

    // 3. Checklist Configurations (Templates)
    match /salons/{salonId}/checklists/{checklistId} {
      allow read: if isSignedIn() && exists(userDoc()) && userSalonId() == salonId;
      allow write: if canEvaluateTeam(salonId);
    }

    // 4. Checklist Daily Runs (Essenza Evaluations)
    match /salons/{salonId}/checklistRuns/{runId} {
      allow read: if isSignedIn() && exists(userDoc()) && userSalonId() == salonId;
      allow create, update, delete: if canEvaluateTeam(salonId);
    }

    // 5. Monthly Goals
    match /salons/{salonId}/goals/{goalId} {
      allow read: if isSignedIn() && exists(userDoc()) && userSalonId() == salonId;
      allow write: if canManageSalon(salonId);
    }

    // 6. Professional-assigned Goals
    match /salons/{salonId}/professionalGoals/{goalId} {
      allow read: if canManageSalon(salonId) || (
        isSalonProfessional(salonId) && resource.data.professionalId == request.auth.uid
      );
      allow create, update, delete: if canManageSalon(salonId);
    }

    // 7. Clients
    match /salons/{salonId}/clients/{clientId} {
      allow get: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
      allow list: if canOperateFrontDesk(salonId);
      allow create, update, delete: if canOperateFrontDesk(salonId);
    }

    // 8. Services Catalogue
    match /salons/{salonId}/services/{serviceId} {
      allow read: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
      allow create, update, delete: if canManageSalon(salonId);
    }

    // 9. Categories
    match /salons/{salonId}/categories/{categoryId} {
      allow read: if canOperateFrontDesk(salonId) || isSalonProfessional(salonId);
      allow create, update, delete: if canManageSalon(salonId);
    }

    // Fallback Catch-All for any other subcollections under salons
    match /salons/{salonId}/{collectionName}/{docId} {
      allow read, write: if isPlatformAdmin();
    }
  }
}
