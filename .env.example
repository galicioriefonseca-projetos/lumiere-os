# ==========================================================
# LUMIÈREOS — VARIÁVEIS DE AMBIENTE
# Nunca envie valores reais de segredos para o repositório.
# ==========================================================

# Aplicação e origens
APP_URL="https://seu-dominio.com.br"
ALLOWED_ORIGINS="https://seu-dominio.com.br,https://www.seu-dominio.com.br"
HEALTHCHECK_SECRET="gere-um-segredo-longo-e-aleatorio"

# IA
GEMINI_API_KEY=""

# Firebase Web SDK — valores públicos usados no frontend
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_VAPID_KEY=""

# Firebase Admin — prefira uma única variável com o JSON integral da conta de serviço.
# O código também aceita o JSON codificado em base64.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"}'
FIREBASE_EXPECTED_PROJECT_ID=""

# Fallback legado para ambientes que não aceitam JSON integral.
# As três variáveis precisam vir da MESMA conta de serviço.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Administrador da plataforma
# Fallback temporário do backend. Prefira platformAdmins/{uid} no Firestore.
PLATFORM_ADMIN_EMAIL="admin@example.com"

# E-mail transacional (envio do link de acesso após pagamento aprovado)
# Crie uma conta gratuita em https://resend.com, gere uma API key e verifique
# um domínio/remetente próprio antes de ir para produção.
RESEND_API_KEY=""
EMAIL_FROM="LumièreOS <contato@seu-dominio.com.br>"

# Cakto — produção
CAKTO_CLIENT_ID=""
CAKTO_CLIENT_SECRET=""
CAKTO_API_URL="https://api.cakto.com.br"
CAKTO_WEBHOOK_SECRET=""
CAKTO_SANDBOX_MODE="false"

# Configurações públicas de suporte e cobrança manual
VITE_SUPPORT_WHATSAPP="5511999999999"
VITE_SUPPORT_EMAIL="suporte@example.com"
VITE_BILLING_PIX_KEY=""
VITE_BILLING_PIX_KEY_TYPE="email"
VITE_BILLING_RECEIVER_NAME="LumièreOS"
VITE_BILLING_PAYMENT_INSTRUCTIONS="Após realizar o pagamento manual, informe o comprovante para validação da assinatura."

# Demonstração — desativada em produção
VITE_ENABLE_DEMO_MODE="false"
VITE_DEMO_USER_EMAIL="demo@example.com"


# Identidade pública da aplicação
VITE_APP_NAME="LumièreOS"
VITE_APP_VERSION="1.6.0-rc.1"
VITE_COMPANY_NAME="Sua empresa"
VITE_COMPANY_WEBSITE="https://example.com"
VITE_RELEASE_DATE="2026-07-15"

# Links públicos e documentação jurídica revisada
VITE_TERMS_URL="https://example.com/termos"
VITE_PRIVACY_URL="https://example.com/privacidade"
VITE_LICENSE_URL="https://example.com/licenca"
VITE_CAKTO_POLICY_URL=""
VITE_INSTAGRAM_URL=""
VITE_LINKEDIN_URL=""
