# GEMINI_API_KEY: Requerido para chamadas da API do Gemini AI.
# O AI Studio injeta isso automaticamente em runtime a partir das variáveis do usuário.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: A URL onde este applet do LumièreOS é executado/hospedado.
APP_URL="MY_APP_URL"

# Configurações do Firebase Client-Side (Públicas, permitidas com VITE_)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Emails de Administração / Demonstração do Painel Lumière
VITE_DEMO_USER_EMAIL="leandropfonseca20@gmail.com"
VITE_PLATFORM_ADMIN_EMAIL="galicioriefonseca@gmail.com"

# INTEGRATION: API ASAAS (Sandbox e Produção)
# NUNCA declare chaves confidenciais com o prefixo "VITE_", pois as exporá ao navegador!
ASAAS_API_ENV="sandbox"               # Escolha entre "sandbox" ou "production"
ASAAS_API_KEY_SANDBOX="your_asaas_sandbox_api_key_here"
ASAAS_API_KEY_PRODUCTION="your_asaas_production_api_key_here"

# Webhook de Faturamento do Asaas para Sincronização Dinâmica de Faturas
ASAAS_WEBHOOK_TOKEN="your_asaas_webhook_validation_token_here"

# FIREBASE ADMIN SDK (Segurança de nível de servidor backend para provisionamento e assinaturas)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@xxxxxx.iam.gserviceaccount.com"
# Lembre-se de escapar quebras de linha (\n) na chave privada do Firebase Admin
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqh...your_private_key_here...\n-----END PRIVATE KEY-----\n"

# INTEGRATION: STRIPE RECURRING BILLING CARD SUBSCRIPTION
# Chave pública para o Frontend (Permitido com VITE_)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Chaves privadas confidenciais para o Backend (NUNCA usar VITE_)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# IDs dos Preços Recorrentes cadastrados no Stripe Dashboard (Monthly Prices)
STRIPE_PRICE_START="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_STUDIO="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PERFORMANCE="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_NETWORK="price_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_FOUNDER="price_xxxxxxxxxxxxxxxxxxxxxxxx"
