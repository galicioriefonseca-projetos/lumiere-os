# GEMINI_API_KEY: Requerido para chamadas da API do Gemini AI.
# O AI Studio injeta isso automaticamente em runtime a partir das variáveis do usuário.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: A URL onde este applet do LumièreOS é executado/hospedado.
APP_URL="MY_APP_URL"

# Configurações do Firebase Client-Side (Públicas, permitidas com VITE_)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_VAPID_KEY=""

# Emails de Administração / Demonstração do Painel Lumière
VITE_DEMO_USER_EMAIL="leandropfonseca20@gmail.com"
VITE_PLATFORM_ADMIN_EMAIL="galicioriefonseca@gmail.com"



# =========================================================================
# CONFIGURAÇÕES MERCADO PAGO [LEGADO / OPCIONAL]
# O faturamento principal agora é operado via Asaas.
# =========================================================================
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MP_PLAN_FOUNDER_AMOUNT=297
# MP_PLAN_START_AMOUNT=197
# MP_PLAN_STUDIO_AMOUNT=397
# MP_PLAN_PERFORMANCE_AMOUNT=697
# MP_PLAN_NETWORK_AMOUNT=1497
# VITE_MP_PUBLIC_KEY=

# =========================================================================
# CONFIGURAÇÕES CAKTO GATEWAY PRINCIPAL (Sprint Atual)
# Obs: CAKTO_CLIENT_ID e CAKTO_CLIENT_SECRET são estritamente secretos e
# obrigatórios em ambiente de produção (NODE_ENV=production).
# =========================================================================
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_API_URL=https://api.cakto.com.br
CAKTO_WEBHOOK_SECRET=

# =========================================================================
# CONFIGURAÇÕES ASAAS [LEGADO / INTEGRADO]
# O Asaas agora atua como sistema de cobrança legado.
# =========================================================================
# ASAAS_API_KEY=
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_SECRET=

# Valores e Planos Asaas Assinaturas (Opcionais - utiliza fallbacks se omitido)
# ASAAS_PLAN_FOUNDER_AMOUNT=297
# ASAAS_PLAN_START_AMOUNT=197
# ASAAS_PLAN_STUDIO_AMOUNT=397
# ASAAS_PLAN_PERFORMANCE_AMOUNT=697
# ASAAS_PLAN_NETWORK_AMOUNT=1497

# FIREBASE ADMIN SDK (Segurança de nível de servidor backend para provisionamento e assinaturas)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@xxxxxx.iam.gserviceaccount.com"
# Lembre-se de escapar quebras de linha (\n) na chave privada do Firebase Admin
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqh...your_private_key_here...\n-----END PRIVATE KEY-----\n"


