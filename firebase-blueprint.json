{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil do usuário integrado com o Firebase Auth.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID exclusivo (UID) do usuário." },
        "fullName": { "type": "string", "description": "Nome completo do usuário." },
        "email": { "type": "string", "description": "E-mail cadastrado." },
        "phone": { "type": "string", "description": "Telefone de contato." },
        "role": { "type": "string", "enum": ["owner", "admin", "manager", "receptionist", "attendant", "professional", "platform_admin"], "description": "Função/Cargo do usuário dentro do salão." },
        "salonId": { "type": "string", "description": "ID do salão de beleza a que o usuário pertence." },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "fullName", "email", "role", "salonId", "createdAt", "updatedAt"]
    },
    "Salon": {
      "title": "Salon",
      "description": "Estabelecimento principal gerenciado pelo LumiereOS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "phone": { "type": "string" },
        "businessType": { "type": "string", "enum": ["salon", "clinic", "barbershop", "studio", "other"] },
        "plan": { "type": "string", "enum": ["start", "studio", "performance", "network", "founder"] },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "pending_payment", "overdue", "canceled"] },
        "activationStatus": { "type": "string", "enum": ["active", "pending", "blocked", "canceled"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "name", "ownerId", "ownerEmail", "plan", "subscriptionStatus", "activationStatus", "isActive", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Histórico e relatórios de faturamento do salão.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["pix", "credit_card"] },
        "status": { "type": "string", "enum": ["reported", "paid", "rejected", "canceled"] },
        "reportedByUserId": { "type": "string" },
        "reportedAt": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "plan", "amount", "method", "status", "reportedByUserId", "reportedAt", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro de alteração crítica no Firestore para auditoria.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string", "enum": ["create", "update", "delete", "status_change", "report", "auth"] },
        "targetEntity": { "type": "string", "enum": ["checklistRuns", "payments", "goals", "professionals", "services", "clients", "salon", "user"] },
        "targetId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "userId", "userName", "userEmail", "userRole", "action", "targetEntity", "targetId", "description", "createdAt"]
    },
    "SavedPricing": {
      "title": "SavedPricing",
      "description": "Cálculo de precificação ideal de um serviço baseado em custos operacionais e insumos.",
      "type": "object",
      "properties": {
        "serviceName": { "type": "string" },
        "durationHours": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "hourlyChairCost": { "type": "number" },
        "monthlyCosts": { "type": "number" },
        "productsCost": { "type": "number" },
        "suggestedPrice": { "type": "number" },
        "selectedProfitMargin": { "type": "number" },
        "businessProfit": { "type": "number" },
        "partnerProfit": { "type": "number" },
        "partnerCommissionPercent": { "type": "number" },
        "createdAt": { "type": "integer" }
      },
      "required": ["serviceName", "durationHours", "durationMinutes", "hourlyChairCost", "monthlyCosts", "productsCost", "suggestedPrice", "selectedProfitMargin", "businessProfit", "partnerProfit", "partnerCommissionPercent", "createdAt"]
    },
    "ProductionLog": {
      "title": "ProductionLog",
      "description": "Registro de erro ou evento em produção para suporte e depuração.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "level": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "pagePath": { "type": "string" },
        "userAgent": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "level", "message", "pagePath", "userAgent", "isActive", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Cupom de desconto para ativação de planos.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["free_pro"] },
        "isValid": { "type": "boolean" },
        "expiresAt": { "type": "integer" }
      },
      "required": ["code", "type", "isValid"]
    },
    "Report": {
      "title": "Report",
      "description": "Relatório de performance de marketing da agência para o cliente.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "title": { "type": "string" },
        "period": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "integer" }
      },
    "Report": {
      "title": "Report",
      "description": "Relatório de performance de marketing da agência para o cliente.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "title": { "type": "string" },
        "period": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "title", "period", "createdAt"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Contrato de prestação de serviços da agência para o cliente.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "title": { "type": "string" },
        "contractType": { "type": "string" },
        "monthlyValue": { "type": "number" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "title", "startDate", "status", "createdAt"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Fluxo de aprovação de peças ou conteúdos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["instagram_post", "landing_page", "gmn_post", "other"] },
        "status": { "type": "string", "enum": ["pending", "approved", "revisions_requested"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "title", "type", "status", "createdAt"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "Central de suporte para clientes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "subject", "status", "createdAt"]
    },
    "Deliverable": {
      "title": "Deliverable",
      "description": "Cronograma de entregas.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "title", "dueDate", "status", "createdAt"]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Pedido de serviço extra ou up-sell.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "clientId": { "type": "string" },
        "serviceName": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "quoted", "accepted", "rejected"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "serviceName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção global de perfis de usuários."
    },
    "/salons/{salonId}": {
      "schema": "Salon",
      "description": "Coleção central de estabelecimentos/parceiros."
    },
    "/salons/{salonId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Subcoleção de registros de pagamentos do salão."
    },
    "/salons/{salonId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Subcoleção de logs de auditoria de segurança e ações do salão."
    },
    "/salons/{salonId}/pricing_calculations/{calculationId}": {
      "schema": "SavedPricing",
      "description": "Subcoleção contendo fórmulas de precificação de serviços salvas pelo salão."
    },
    "/salons/{salonId}/productionLogs/{logId}": {
      "schema": "ProductionLog",
      "description": "Subcoleção contendo logs de erros em produção para suporte e depuração."
    },
    "/salons/{salonId}/reports/{reportId}": {
      "schema": "Report",
      "description": "Subcoleção contendo relatórios de marketing para clientes."
    },
    "/salons/{salonId}/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Subcoleção contendo contratos de prestação de serviços para clientes."
    },
    "/salons/{salonId}/approvals/{approvalId}": {
      "schema": "Approval",
      "description": "Subcoleção para fluxo de aprovação de conteúdos."
    },
    "/salons/{salonId}/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Subcoleção de tickets de suporte."
    },
    "/salons/{salonId}/deliverables/{deliverableId}": {
      "schema": "Deliverable",
      "description": "Subcoleção de cronograma de entregas."
    },
    "/salons/{salonId}/serviceRequests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Subcoleção de pedidos de serviços extras."
    },
    "/coupons/{code}": {
      "schema": "Coupon",
      "description": "Coleção contendo cupons de desconto válidos."
    }
  }
}
