{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil do usuário integrado com o Firebase Auth.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID exclusivo (UID) do usuário." },
        "fullName": { "type": "string", "description": "Nome completo do usuário." },
        "email": { "type": "string", "description": "E-mail cadastrado." },
        "phone": { "type": "string", "description": "Telefone de contato." },
        "role": { "type": "string", "enum": ["owner", "admin", "manager", "receptionist", "attendant", "professional", "platform_admin"], "description": "Função/Cargo do usuário dentro do salão." },
        "salonId": { "type": "string", "description": "ID do salão de beleza a que o usuário pertence." },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "fullName", "email", "role", "salonId", "createdAt", "updatedAt"]
    },
    "Salon": {
      "title": "Salon",
      "description": "Estabelecimento principal gerenciado pelo LumiereOS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "phone": { "type": "string" },
        "businessType": { "type": "string", "enum": ["salon", "clinic", "barbershop", "studio", "other"] },
        "plan": { "type": "string", "enum": ["start", "studio", "performance", "network", "founder"] },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "pending_payment", "overdue", "canceled"] },
        "activationStatus": { "type": "string", "enum": ["active", "pending", "blocked", "canceled"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "name", "ownerId", "ownerEmail", "plan", "subscriptionStatus", "activationStatus", "isActive", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Histórico e relatórios de faturamento do salão.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["pix", "credit_card"] },
        "status": { "type": "string", "enum": ["reported", "paid", "rejected", "canceled"] },
        "reportedByUserId": { "type": "string" },
        "reportedAt": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "plan", "amount", "method", "status", "reportedByUserId", "reportedAt", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro de alteração crítica no Firestore para auditoria.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string", "enum": ["create", "update", "delete", "status_change", "report", "auth"] },
        "targetEntity": { "type": "string", "enum": ["checklistRuns", "payments", "goals", "professionals", "services", "clients", "salon", "user"] },
        "targetId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "salonId", "userId", "userName", "userEmail", "userRole", "action", "targetEntity", "targetId", "description", "createdAt"]
    },
    "SavedPricing": {
      "title": "SavedPricing",
      "description": "Cálculo de precificação ideal de um serviço baseado em custos operacionais e insumos.",
      "type": "object",
      "properties": {
        "serviceName": { "type": "string" },
        "durationHours": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "hourlyChairCost": { "type": "number" },
        "monthlyCosts": { "type": "number" },
        "productsCost": { "type": "number" },
        "suggestedPrice": { "type": "number" },
        "selectedProfitMargin": { "type": "number" },
        "businessProfit": { "type": "number" },
        "partnerProfit": { "type": "number" },
        "partnerCommissionPercent": { "type": "number" },
        "createdAt": { "type": "integer" }
      },
      "required": ["serviceName", "durationHours", "durationMinutes", "hourlyChairCost", "monthlyCosts", "productsCost", "suggestedPrice", "selectedProfitMargin", "businessProfit", "partnerProfit", "partnerCommissionPercent", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção global de perfis de usuários."
    },
    "/salons/{salonId}": {
      "schema": "Salon",
      "description": "Coleção central de estabelecimentos/parceiros."
    },
    "/salons/{salonId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Subcoleção de registros de pagamentos do salão."
    },
    "/salons/{salonId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Subcoleção de logs de auditoria de segurança e ações do salão."
    },
    "/salons/{salonId}/pricing_calculations/{calculationId}": {
      "schema": "SavedPricing",
      "description": "Subcoleção contendo fórmulas de precificação de serviços salvas pelo salão."
    }
  }
}
